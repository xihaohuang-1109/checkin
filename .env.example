# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-string

# Feishu (Lark) Self-built App
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback

# Database (PostgreSQL — e.g. Supabase or Neon free tier)
# For Supabase: Project Settings → Database → Connection string (URI mode)
# For Neon: Dashboard → Connection Details → Prisma (or URI)
# Note: use the "pooled" connection string from Neon, or the Supabase
# transaction-mode string. For Render, this is set in the dashboard.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Bitable
FEISHU_BITABLE_NAME=伙伴赋能培训签到信息表

# Dedup
DEDUP_IP_SALT=change-me-to-a-random-salt